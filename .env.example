### Copy this file to `.env` and fill in real credentials. NEVER commit `.env` to version control.
DB_HOST=your-database-host.example.com
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# Required: Flask secret key for session signing (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_value

# Optional SMTP configuration for security email alerts and onboarding emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_SSL=0
# SMTP_USER=alerts@example.com
# SMTP_PASS=change_me
# PLATFORM_SECURITY_ALERT_EMAIL_FROM=alerts@example.com

# Optional global security notification controls
# PLATFORM_SECURITY_NOTIFY_SEVERITIES=high,critical
# PLATFORM_SECURITY_NOTIFICATION_THROTTLE_MINUTES=30
# PLATFORM_SECURITY_WEBHOOK_TIMEOUT_SECONDS=10

# Optional relay configuration for forwarding signed security webhooks to Splunk and Sentinel
# PLATFORM_SECURITY_RELAY_URL=http://127.0.0.1:8080
# PLATFORM_SECURITY_SHARED_SECRET=change_me_to_a_strong_random_value
# SECURITY_RELAY_ENABLE_FORWARDING=0
# SECURITY_RELAY_PORT=8080
# SECURITY_RELAY_SIGNATURE_TOLERANCE_SECONDS=300
# SECURITY_RELAY_FORWARD_TIMEOUT_SECONDS=10
# SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
# SPLUNK_HEC_TOKEN=change_me
# SPLUNK_HEC_SOURCE=uniform-issuance-app
# SPLUNK_HEC_SOURCETYPE=platform:security:event
# SENTINEL_LOGIC_APP_URL=https://prod-00.westeurope.logic.azure.com/workflows/...
# SENTINEL_BEARER_TOKEN=
